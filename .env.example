# Postgres
DATABASE_URL=postgres://localhost:5432/recovery_agent

# Tier 1 specialists. Optional: without it Tier 0 still handles ~95% of cases
# and Tier 1 escalates in degraded mode, but the ablation cannot measure the
# model's contribution.
OPENAI_API_KEY=

# Razorpay Test Mode — the narrow live proof path (Phase 11).
# The adapter only exposes createPaymentLink and fetchPaymentStatus.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signing key for capability tokens. Any long random string.
CAPABILITY_SIGNING_KEY=
