{
  "name": "revenue-recovery-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "createdb recovery_agent || true",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:reset": "dropdb --if-exists recovery_agent && createdb recovery_agent && npm run db:migrate",
    "lint:clock": "tsx scripts/lint-clock.ts",
    "batch": "tsx packages/sim/src/cli.ts",
    "console": "tsx packages/console/src/server.ts",
    "tui": "tsx packages/tui/src/tui.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  }
}